#!/bin/bash
# 安装前预检：只做只读检查，不修改系统
set -u
PY=""
for c in python3 /usr/bin/python3 /usr/local/bin/python3 python; do
    if command -v "$c" >/dev/null 2>&1; then PY=$(command -v "$c"); break; fi
done
if [ -z "$PY" ]; then
    echo "[ipsense] 未找到 python3，无法安装" >&2
    exit 1
fi
V=$("$PY" -c 'import sys;print(sys.version_info[0]*100+sys.version_info[1])' 2>/dev/null)
if [ -n "$V" ] && [ "$V" -lt 308 ]; then
    echo "[ipsense] 需要 Python 3.8+，当前版本过低" >&2
    exit 1
fi
if [ ! -d /vol1 ]; then
    echo "[ipsense] 未发现 /vol1 数据卷" >&2
    exit 1
fi
echo "[ipsense] 环境预检通过 (python=$PY)"
exit 0
